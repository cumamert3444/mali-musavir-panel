# Bu dosyayı .env olarak kopyalayip kendi degerlerinizle doldurun.
# cp .env.example .env

# Genel
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Veritabani (bos birakilirsa gelistirme icin SQLite kullanilir)
DATABASE_URL=postgres://panel_user:panel_pass@localhost:5432/mali_musavir_panel

# Celery / Redis (beyanname hatirlatma gorevleri icin)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# API modu
# Global API anahtari: kapatilirsa tum tenant'lar icin dıs API erisimi devre disi kalir.
API_ENABLED=True

# CORS (frontend ayri bir origin'den calisiyorsa)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# E-posta (bildirimler icin; bos birakilirsa konsola yazdirilir)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# SMS/WhatsApp saglayici (ileride entegre edilecek; simdilik bos)
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
